          },
          {
            "name": "license",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "License"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Format"
            }
          },
          {
            "name": "face_count_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Face Count Min"
            }
          },
          {
            "name": "face_count_max",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Face Count Max"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 12,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetListResponse"
                },
                "example": {
                  "items": [
                    {
                      "asset_id": "mock-asset-001",
                      "name": "Ghế gỗ đơn giản",
                      "description": "Bản ghi minh họa tự tạo; không có file asset 3D thật.",
                      "category": "Nội thất",
                      "tags": [
                        "ghế",
                        "gỗ",
                        "chair",
                        "wood"
                      ],
                      "formats": [
                        "glb"
                      ],
                      "face_count": null,
                      "thumbnail_url": null,
                      "source": "mock",
                      "source_url": null,
                      "author": null,
                      "license": null
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 12,
                    "total": 1,
                    "pages": 1,
                    "has_next": false
                  },
                  "mock": false
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "Yêu cầu không hợp lệ.",
                    "details": []
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "ASSET_NOT_FOUND",
                    "message": "Không tìm thấy tài nguyên.",
                    "details": []
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Lỗi máy chủ. Vui lòng thử lại sau.",
                    "details": []
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        }
      }
    },
