# Copy to .env at repository root. Do not commit .env.
APP_NAME="3D Asset Semantic Search API"
APP_ENV=development
APP_DEBUG=false
BACKEND_PORT=8000

# Local development only; replace this example password in .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=semantic_search
POSTGRES_USER=semantic
POSTGRES_PASSWORD=change-me-local
# Optional override (percent-encode reserved characters in a URL):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/database
