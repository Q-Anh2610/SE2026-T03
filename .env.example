# Copy to .env at repository root. Do not commit .env.
APP_NAME="3D Asset Semantic Search API"
APP_ENV=development
APP_DEBUG=false
BACKEND_PORT=8000
APP_MOCK_API_ENABLED=true
APP_ASSET_LIST_SOURCE=database
APP_TEXT_SEARCH_SOURCE=mock
APP_IMAGE_SEARCH_SOURCE=mock
APP_FEEDBACK_SOURCE=mock
# Dùng database để nhận feedback từ search event thật, sau alembic upgrade head.
# APP_IMAGE_INDEX_MANIFEST=C:/path/to/image-index-manifest.json
# APP_IMAGE_INDEX_ROOT=C:/path/to/handoff-root
APP_IMAGE_QDRANT_URL=http://127.0.0.1:6333
# Storage ảnh riêng với text khi dùng Qdrant local.
# APP_IMAGE_QDRANT_LOCAL_PATH=C:/path/to/existing-image-qdrant
# APP_IMAGE_QDRANT_API_KEY=your-local-key
# Khi dùng service, đặt đường dẫn tuyệt đối tới manifest và root gói index đã dựng.
# APP_TEXT_INDEX_MANIFEST=C:/path/to/index-manifest.json
# APP_TEXT_INDEX_ROOT=C:/path/to/handoff-root
APP_TEXT_QDRANT_URL=http://127.0.0.1:6333
# Hoặc dùng index Qdrant local đã có; chỉ một process được mở storage này.
# APP_TEXT_QDRANT_LOCAL_PATH=C:/path/to/existing-qdrant
# APP_TEXT_QDRANT_API_KEY=your-local-key
APP_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Local development only; replace this example password in .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=semantic_search
POSTGRES_USER=semantic
POSTGRES_PASSWORD=change-me-local
# Optional override (percent-encode reserved characters in a URL):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/database
